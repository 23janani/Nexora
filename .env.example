# ==============================================================================
# Resume Matcher Enterprise - Example Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your real credentials:
# cp .env.example .env

# Google Gemini API Key (Enables cloud-based generative AI question synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# Enterprise REST API Security Key
ENTERPRISE_API_KEY=resume_matcher_enterprise_key_2026

# Flask Session Key
FLASK_SECRET_KEY=enterprise_secret_recruiting_key_2026

# Application Port & Host
PORT=5001
HOST=127.0.0.1
